#!/usr/bin/env bash

set -Eeuo pipefail

ONE_DOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

od_echo_success() {
  printf '[OK] %s\n' "$*"
}

od_echo_error() {
  printf '[ERROR] %s\n' "$*" >&2
}

od_unknown_os() {
  case "$(uname -s)" in
    Darwin|Linux) return 1 ;;
    *) return 0 ;;
  esac
}

od_pwd() {
  printf '%s\n' "$ONE_DOT"
}

od_action_link() {
  local source="$1"
  local target="$2"

  if [[ ! -e "$source" ]]; then
    od_echo_error "link source does not exist: $source"
    return 1
  fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    od_echo_error "refusing to replace regular file or directory: $target"
    return 1
  fi
  mkdir -p "$(dirname -- "$target")"
  ln -sfn "$source" "$target"
}

od_action_linkdir() {
  od_action_link "$1" "$2"
}

od_action_rm() {
  local target="$1"

  if [[ -L "$target" || -e "$target" ]]; then
    if [[ ! -L "$target" ]]; then
      od_echo_error "refusing to remove regular file or directory: $target"
      return 1
    fi
    rm -- "$target"
  fi
}

od_run_installer() {
  local installer="$1"

  if [[ ! -f "$installer" ]]; then
    od_echo_error "installer not found: $installer"
    return 1
  fi
  source "$installer"
}

if od_unknown_os; then
  od_echo_error "Operating system not supported: $(uname -s)"
  exit 1
fi

installers=(
  "$ONE_DOT/git/install.sh"
  "$ONE_DOT/zsh/install.sh"
  "$ONE_DOT/vim/install.sh"
)

for installer in "${installers[@]}"; do
  od_run_installer "$installer"
done

od_echo_success "Installation complete"